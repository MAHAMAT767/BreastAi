# ============================================================
# BreastAI — variables d'environnement (docker compose + local)
# Copiez ce fichier vers .env et remplacez les valeurs.
# ============================================================

# ---------- Application ----------
APP_NAME=BreastAI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- PostgreSQL ----------
POSTGRES_USER=breastai
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=breastai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port exposé sur la machine hôte. À changer si un PostgreSQL local occupe déjà 5432.
POSTGRES_HOST_PORT=5432
# Laisser vide pour construire l'URL depuis les variables ci-dessus.
DATABASE_URL=

# ---------- Administrateur initial (python -m app.database.init_db) ----------
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Administrateur BreastAI

# ---------- Sécurité / JWT (Phase 2) ----------
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Limitation de débit ----------
# Compteurs en mémoire, par processus : à basculer sur Redis avant tout
# déploiement multi-instance (voir docs/API.md).
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
PASSWORD_RESET_RATE_LIMIT=5/minute

# ---------- Stockage des images ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---------- IA (Phase 4) ----------
MODEL_PATH=./models/breastai_efficientnet.pt
MODEL_DEVICE=cpu

# ---------- Assistant conversationnel (Hugging Face) ----------
# Jeton personnel Hugging Face, portée « read » suffisante.
# Sans jeton, l'assistant est simplement désactivé : le reste fonctionne.
#
# ⚠️ Le crédit mensuel inclus d'un compte gratuit s'épuise en quelques dizaines
#    de questions. Voir docs/API.md.
HUGGINGFACE_API_TOKEN=
ASSISTANT_BASE_URL=https://router.huggingface.co/v1
ASSISTANT_MODEL=Qwen/Qwen2.5-7B-Instruct
ASSISTANT_MAX_TOKENS=400
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_TIMEOUT_SECONDS=45
ASSISTANT_HISTORY_TURNS=6
ASSISTANT_RATE_LIMIT=10/minute

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
